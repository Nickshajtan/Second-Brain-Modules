  "cases": [
    {
      "name": "previous producer to current optional reader",
      "schema": "optional_added",
      "instance": {
        "operation": "synthetic.read",
        "state": "active"
      },
      "valid": true
    },
    {
      "name": "current producer with new field to previous closed reader",
      "schema": "previous",
      "instance": {
        "operation": "synthetic.read",
        "state": "active",
        "label": "x"
      },
      "valid": false
    },
    {
      "name": "current producer omitting new optional field to previous reader",
      "schema": "previous",
      "instance": {
        "operation": "synthetic.read",
        "state": "active"
      },
      "valid": true
    },
    {
      "name": "old enum producer to expanded reader",
      "schema": "enum_expanded",
      "instance": {
        "operation": "synthetic.read",
        "state": "active"
      },
      "valid": true
    },
    {
      "name": "expanded enum producer to old reader",
      "schema": "previous",
      "instance": {
        "operation": "synthetic.read",
        "state": "archived"
      },
      "valid": false
    },
    {
      "name": "required addition rejects old producer",
      "schema": "required_added",
      "instance": {
        "operation": "synthetic.read",
        "state": "active"
      },
      "valid": false
    },
    {
      "name": "required addition current accepts new producer",
      "schema": "required_added",
      "instance": {
        "operation": "synthetic.read",
        "state": "active",
        "label": "x"
      },
      "valid": true
    },
    {
      "name": "rename rejects old producer",
      "schema": "renamed",
      "instance": {
        "operation": "synthetic.read",
        "state": "active"
      },
      "valid": false
    },
    {
      "name": "old reader rejects renamed producer",
      "schema": "previous",
      "instance": {
        "operation": "synthetic.read",
        "status": "active"
      },
      "valid": false
    },
    {
      "name": "changed operation discriminator rejects",
      "schema": "previous",
      "instance": {
        "operation": "synthetic.write",
        "state": "active"
      },
      "valid": false
    }
  ]
