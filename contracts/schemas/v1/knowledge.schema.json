{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nickshajtan/Second-Brain-Modules/contracts/1.0.0/knowledge.schema.json",
  "title": "KnowledgeRecord",
  "oneOf": [
    {
      "$ref": "#/$defs/Node"
    },
    {
      "$ref": "#/$defs/NodeRevision"
    },
    {
      "$ref": "#/$defs/NodeTypeDefinition"
    },
    {
      "$ref": "#/$defs/Cluster"
    },
    {
      "$ref": "#/$defs/Membership"
    },
    {
      "$ref": "#/$defs/Collection"
    },
    {
      "$ref": "#/$defs/Relation"
    },
    {
      "$ref": "#/$defs/RelationTypeDefinition"
    },
    {
      "$ref": "#/$defs/Asset"
    },
    {
      "$ref": "#/$defs/ExternalReference"
    },
    {
      "$ref": "#/$defs/ProvenanceRecord"
    }
  ],
  "$defs": {
    "NodeContent": {
      "title": "NodeContent",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "not": {
            "pattern": "[\\r\\n]"
          }
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "body": {
          "type": "string",
          "maxLength": 1000000
        },
        "properties": {
          "$ref": "common.schema.json#/$defs/FlatProperties"
        },
        "metadata_schema_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ProvenanceRef"
          },
          "maxItems": 1000
        },
        "valid_from": {
          "$ref": "common.schema.json#/$defs/UtcTimestamp"
        },
        "valid_until": {
          "$ref": "common.schema.json#/$defs/UtcTimestamp"
        },
        "extensions": {
          "$ref": "common.schema.json#/$defs/Extensions"
        },
        "node_type_version": {
          "$ref": "common.schema.json#/$defs/DefinitionVersion"
        }
      },
      "required": [
        "node_type",
        "title",
        "body",
        "properties",
        "provenance",
        "node_type_version"
      ]
    },
    "Node": {
      "title": "Node",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "node"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/EntityId"
        },
        "schema_version": {
          "$ref": "common.schema.json#/$defs/SchemaVersion"
        },
        "revision": {
          "$ref": "common.schema.json#/$defs/EntityRevision"
        },
        "content": {
          "$ref": "#/$defs/NodeContent"
        },
        "revision_ref": {
          "$ref": "common.schema.json#/$defs/RevisionRef"
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "active",
            "archived",
            "pending_disposal"
          ]
        },
        "created_at": {
          "$ref": "common.schema.json#/$defs/UtcTimestamp"
        },
        "updated_at": {
          "$ref": "common.schema.json#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "kind",
        "id",
        "schema_version",
        "revision",
        "content",
        "revision_ref",
        "lifecycle",
        "created_at",
        "updated_at"
      ]
    },
    "NodeRevision": {
      "title": "NodeRevision",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "node_revision"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/EntityId"
        },
        "schema_version": {
          "$ref": "common.schema.json#/$defs/SchemaVersion"
        },
        "node_id": {
          "$ref": "common.schema.json#/$defs/EntityId"
        },
        "logical_revision": {
          "$ref": "common.schema.json#/$defs/EntityRevision"
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "recorded_by": {
          "$ref": "common.schema.json#/$defs/PrincipalRef"
        },
        "recorded_at": {
          "$ref": "common.schema.json#/$defs/UtcTimestamp"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ProvenanceRef"
          },
          "maxItems": 1000
        },
        "previous": {
          "$ref": "common.schema.json#/$defs/RevisionRef"
        }
      },
      "required": [
        "kind",
        "id",
        "schema_version",
        "node_id",
        "logical_revision",
        "digest",
        "recorded_by",
        "recorded_at",
        "provenance"
      ]
    },
    "NodeTypeDefinition": {
      "title": "NodeTypeDefinition",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "node_type_definition"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/EntityId"
        },
        "schema_version": {
          "$ref": "common.schema.json#/$defs/SchemaVersion"
        },
        "revision": {
          "$ref": "common.schema.json#/$defs/EntityRevision"
        },
        "type_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "type_version": {
          "$ref": "common.schema.json#/$defs/DefinitionVersion"
        },
        "metadata_schema_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "flat_properties_required": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "kind",
        "id",
        "schema_version",
        "revision",
        "type_key",
        "type_version",
        "metadata_schema_id",
        "description",
        "flat_properties_required"
      ]
    },
    "Cluster": {
      "title": "Cluster",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "cluster"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/EntityId"
        },
        "schema_version": {
          "$ref": "common.schema.json#/$defs/SchemaVersion"
        },
        "revision": {
          "$ref": "common.schema.json#/$defs/EntityRevision"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "owner": {
          "$ref": "common.schema.json#/$defs/PrincipalRef"
        },
        "policy": {
          "$ref": "common.schema.json#/$defs/PolicyRef"
        },
        "publication_mode": {
          "type": "string",
          "enum": [
            "private",
            "shared"
          ]
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "active",
            "closed"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        }
      },
      "required": [
        "kind",
        "id",
        "schema_version",
        "revision",
        "name",
        "owner",
        "policy",
        "publication_mode",
        "lifecycle"
      ]
    },
    "Membership": {
      "title": "Membership",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "membership"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/EntityId"
        },
        "schema_version": {
          "$ref": "common.schema.json#/$defs/SchemaVersion"
        },
        "revision": {
          "$ref": "common.schema.json#/$defs/EntityRevision"
        },
        "cluster_id": {
          "$ref": "common.schema.json#/$defs/EntityId"
        },
        "node_id": {
          "$ref": "common.schema.json#/$defs/EntityId"
        },
        "admitted_by": {
          "$ref": "common.schema.json#/$defs/PrincipalRef"
        },
        "admitted_at": {
          "$ref": "common.schema.json#/$defs/UtcTimestamp"
        },
        "admission_provenance": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ProvenanceRef"
          },
          "maxItems": 1000
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "active",
            "detached"
          ]
        },
        "approved_revision": {
          "$ref": "common.schema.json#/$defs/RevisionRef"
        },
        "approval_id": {
          "$ref": "common.schema.json#/$defs/EntityId"
        }
      },
      "required": [
        "kind",
        "id",
        "schema_version",
        "revision",
        "cluster_id",
        "node_id",
        "admitted_by",
        "admitted_at",
        "admission_provenance",
        "lifecycle"
      ]
    },
    "Collection": {
      "title": "Collection",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "collection"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/EntityId"
        },
        "schema_version": {
          "$ref": "common.schema.json#/$defs/SchemaVersion"
        },
        "revision": {
          "$ref": "common.schema.json#/$defs/EntityRevision"
        },
        "cluster_id": {
          "$ref": "common.schema.json#/$defs/EntityId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "parent_id": {
          "$ref": "common.schema.json#/$defs/EntityId"
        },
        "node_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/EntityId"
          },
          "maxItems": 10000
        }
      },
      "required": [
        "kind",
        "id",
        "schema_version",
        "revision",
        "cluster_id",
        "name",
        "node_ids"
      ]
    },
    "Relation": {
      "title": "Relation",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "relation"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/EntityId"
        },
        "schema_version": {
          "$ref": "common.schema.json#/$defs/SchemaVersion"
        },
        "revision": {
          "$ref": "common.schema.json#/$defs/EntityRevision"
        },
        "owner_cluster_id": {
          "$ref": "common.schema.json#/$defs/EntityId"
        },
        "source": {
          "$ref": "common.schema.json#/$defs/NodeRef"
        },
        "target": {
          "$ref": "common.schema.json#/$defs/NodeRef"
        },
        "predicate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "not": {
            "pattern": "[\\r\\n]"
          }
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ProvenanceRef"
          },
          "maxItems": 1000
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "active",
            "retired"
          ]
        },
        "valid_from": {
          "$ref": "common.schema.json#/$defs/UtcTimestamp"
        },
        "valid_until": {
          "$ref": "common.schema.json#/$defs/UtcTimestamp"
        },
        "predicate_version": {
          "$ref": "common.schema.json#/$defs/DefinitionVersion"
        }
      },
      "required": [
        "kind",
        "id",
        "schema_version",
        "revision",
        "owner_cluster_id",
        "source",
        "target",
        "predicate",
        "provenance",
        "lifecycle",
        "predicate_version"
      ]
    },
    "RelationTypeDefinition": {
      "title": "RelationTypeDefinition",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "relation_type_definition"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/EntityId"
        },
        "schema_version": {
          "$ref": "common.schema.json#/$defs/SchemaVersion"
        },
        "revision": {
          "$ref": "common.schema.json#/$defs/EntityRevision"
        },
        "predicate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "type_version": {
          "$ref": "common.schema.json#/$defs/DefinitionVersion"
        },
        "symmetric": {
          "type": "boolean"
        },
        "source_node_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 100
        },
        "target_node_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 100
        },
        "self_links_allowed": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "kind",
        "id",
        "schema_version",
        "revision",
        "predicate",
        "type_version",
        "symmetric",
        "source_node_types",
        "target_node_types",
        "self_links_allowed",
        "description"
      ]
    },
    "Asset": {
      "title": "Asset",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "asset"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/EntityId"
        },
        "schema_version": {
          "$ref": "common.schema.json#/$defs/SchemaVersion"
        },
        "revision": {
          "$ref": "common.schema.json#/$defs/EntityRevision"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "storage": {
          "title": "StorageProviderRef",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "object_key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "required": [
            "provider",
            "object_key"
          ]
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/ResourceScope"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ProvenanceRef"
          },
          "maxItems": 1000
        },
        "referenced_by": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ResourceRef"
          },
          "maxItems": 10000
        }
      },
      "required": [
        "kind",
        "id",
        "schema_version",
        "revision",
        "media_type",
        "digest",
        "size_bytes",
        "storage",
        "scope",
        "provenance",
        "referenced_by"
      ]
    },
    "ExternalCheck": {
      "title": "ExternalCheck",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checked_at": {
          "$ref": "common.schema.json#/$defs/UtcTimestamp"
        },
        "checked_by": {
          "$ref": "common.schema.json#/$defs/PrincipalRef"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "available",
            "changed",
            "unavailable",
            "unknown"
          ]
        },
        "locator_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "reported_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ProvenanceRef"
          },
          "maxItems": 1000
        }
      },
      "required": [
        "checked_at",
        "checked_by",
        "outcome",
        "locator_digest",
        "evidence"
      ]
    },
    "ExternalReference": {
      "title": "ExternalReference",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "external_reference"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/EntityId"
        },
        "schema_version": {
          "$ref": "common.schema.json#/$defs/SchemaVersion"
        },
        "revision": {
          "$ref": "common.schema.json#/$defs/EntityRevision"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/ResourceScope"
        },
        "source": {
          "$ref": "common.schema.json#/$defs/SourceRef"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ProvenanceRef"
          },
          "maxItems": 1000
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "last_check": {
          "$ref": "#/$defs/ExternalCheck"
        }
      },
      "required": [
        "kind",
        "id",
        "schema_version",
        "revision",
        "scope",
        "source",
        "provenance"
      ]
    },
    "ProvenanceRecord": {
      "title": "ProvenanceRecord",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "provenance_record"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/EntityId"
        },
        "schema_version": {
          "$ref": "common.schema.json#/$defs/SchemaVersion"
        },
        "source": {
          "$ref": "common.schema.json#/$defs/SourceRef"
        },
        "origin": {
          "type": "string",
          "enum": [
            "human",
            "imported",
            "service",
            "ai_derived"
          ]
        },
        "recorded_by": {
          "$ref": "common.schema.json#/$defs/PrincipalRef"
        },
        "recorded_at": {
          "$ref": "common.schema.json#/$defs/UtcTimestamp"
        },
        "parents": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ProvenanceRef"
          },
          "maxItems": 1000
        },
        "derived_from": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/RevisionRef"
          },
          "maxItems": 1000
        }
      },
      "required": [
        "kind",
        "id",
        "schema_version",
        "source",
        "origin",
        "recorded_by",
        "recorded_at",
        "parents",
        "derived_from"
      ]
    }
  }
}
