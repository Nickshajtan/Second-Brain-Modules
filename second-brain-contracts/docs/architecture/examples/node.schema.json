{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/second-brain/examples/0.1.0/node.schema.json",
  "title": "ExampleKnowledgeNode",
  "description": "ILLUSTRATIVE ONLY. Managed node wire projection: body comes from Markdown, other fields from YAML. Does not prove authorization, provenance resolution or lifecycle validity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "revision", "created_at", "updated_at", "kind", "title", "body", "lifecycle", "sensitivity", "provenance_refs", "relations"],
  "properties": {
    "id": {"$ref": "#/$defs/entity_id"},
    "schema_version": {"const": "0.1.0", "type": "string"},
    "revision": {"$ref": "#/$defs/revision"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "updated_at": {"$ref": "#/$defs/timestamp"},
    "kind": {"type": "string", "enum": ["note", "claim", "decision"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 240},
    "body": {"type": "string", "maxLength": 1000000},
    "lifecycle": {"type": "string", "enum": ["draft", "active", "deprecated", "archived"]},
    "sensitivity": {"$ref": "#/$defs/sensitivity"},
    "provenance_refs": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/provenance_ref"}},
    "relations": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/relation"}},
    "topics": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
    "aliases": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 240}}
  },
  "$defs": {
    "entity_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](\\.[0-9]{1,6})?Z$"},
    "sensitivity": {"type": "string", "enum": ["public", "internal", "personal", "sensitive", "secret"]},
    "provenance_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["record_id"],
      "properties": {"record_id": {"$ref": "#/$defs/entity_id"}}
    },
    "relation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "target_id"],
      "properties": {
        "id": {"$ref": "#/$defs/entity_id"},
        "type": {"type": "string", "enum": ["about", "part-of", "related-to", "supports", "contradicts", "supersedes"]},
        "target_id": {"$ref": "#/$defs/entity_id"},
        "provenance_refs": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/provenance_ref"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "valid_from": {"$ref": "#/$defs/timestamp"},
        "valid_until": {"$ref": "#/$defs/timestamp"}
      }
    }
  }
}
