  "helper_source": "import sys, tempfile, json, hashlib, time\nfrom pathlib import Path\nfrom dataclasses import replace\nfrom unittest.mock import patch\n\nsys.path.insert(0, str(Path.cwd() / 'tools'))\nimport benchmark_history as b\nfrom second_brain_core import Core, rebuild_history_index\n\nrows=json.loads(Path('.cache/m222-stage-a-profile.json').read_text())['rows'] if Path('.cache/m222-stage-a-profile.json').exists() else []\nfor size in (tuple(map(int,sys.argv[1:])) if len(sys.argv)>1 else (100, 1000)):\n    with tempfile.TemporaryDirectory(prefix='m222-stage-a-') as tmp:\n        app, cluster=b.core_fixture.__wrapped__(Path(tmp), b.ContractValidator())\n        principal=app.context.principal\n        app=Core(replace(app.context, principal=replace(principal, grants=principal.grants | frozenset({(cluster,'node.update'),(cluster,'node.history.read')}))), app.store, app.contracts)\n        request=b.batch(app,cluster)\n        app.submit(request)\n        hot=request['operations'][0]['request_id']\n        records=b.extend_mutations(app,cluster,size-2,hot)\n        assert rebuild_history_index(app)['status']=='rebuilt'\n        head=records['node',hot]\n        request=b.mutation_request(app,hot,dict(head['content'], title='measured hashing audit'),head['revision'],app.generation())\n        counters={'sha256_calls':0,'sha256_input_bytes':0,'flat_maps':[],'git_commands':[]}\n        sha=hashlib.sha256\n        digest=b.Core._next_generation.__globals__['digest']\n        run=app.store._run_bytes\n        def hashed(raw=b'',**kwargs):\n            counters['sha256_calls']+=1\n            counters['sha256_input_bytes']+=len(raw)\n            return sha(raw,**kwargs)\n        def digested(value):\n            if isinstance(value,dict) and value and all(isinstance(k,str) and ('knowledge/' in k or k=='control/metadata.json') for k in value):\n                counters['flat_maps'].append({'paths':len(value),'encoded_bytes':len(b.encode(value))})\n            return digest(value)\n        def git(*args,**kwargs):\n            counters['git_commands'].append(args[0])\n            return run(*args,**kwargs)\n        with patch.object(hashlib,'sha256',hashed), patch('second_brain_core.application.digest',digested), patch('second_brain_core.verification.digest',digested), patch.object(app.store,'_run_bytes',git):\n            row=b.hardening_measure(app,'baseline_matched_update',lambda:app.submit(request),100000)\n        row.update(corpus_generations=size,hashing_audit=counters,git_processes=len(counters['git_commands']),git_process_counter_scope='Exact command wrapper; overrides nested harness counter bypassed by instance wrapper')\n        rows.append(row)\n        Path('.cache/m222-stage-a-profile.json').write_text(json.dumps({'rows':rows},indent=2)+'\\n')\n        print(json.dumps({'size':size,'elapsed':row['elapsed_seconds'],'hashing':counters,'components':row['components']}),flush=True)\n",
