  "profile_helper_source": "import sys\nfrom pathlib import Path\nsys.path.insert(0, str(Path.cwd()))\nfrom tools import benchmark_history as b\nfrom contextlib import ExitStack\nfrom dataclasses import replace\nfrom unittest.mock import patch\nimport cProfile, copy, json, sqlite3, tempfile, time, pstats\nfrom second_brain_core.history_index import HistoryIndex\nimport second_brain_core.history_index as hi\n\nOUT=Path('.cache/m221-baseline-profile.json')\nrows=[]\nfor size in (100,1000,10000):\n    with tempfile.TemporaryDirectory(prefix='m221-profile-') as directory:\n        contracts=b.ContractValidator()\n        app,cluster=b.core_fixture.__wrapped__(Path(directory),contracts)\n        p=app.context.principal\n        app=b.Core(replace(app.context,principal=replace(p,grants=p.grants|frozenset((cluster,a) for a in ('node.update','node.history.read')))),app.store,contracts)\n        first=b.batch(app,cluster); app.submit(first)\n        hot=first['operations'][0]['request_id']\n        records=b.extend_mutations(app,cluster,size-2,hot)\n        start=time.perf_counter(); rebuilt=b.rebuild_history_index(app)\n        assert rebuilt['status']=='rebuilt',rebuilt\n        setup=time.perf_counter()-start\n        head=records['node',hot]; content=copy.deepcopy(head['content']);content['title']='profile measured replacement'\n        req=b.mutation_request(app,hot,content,head['revision'],app.generation())\n        metrics={}; writes=[]; git=[]\n        def wrap(owner,name,key):\n            original=getattr(owner,name)\n            def measured(*args,**kwargs):\n                wall=time.perf_counter();cpu=time.process_time()\n                try:return original(*args,**kwargs)\n                finally:\n                    m=metrics.setdefault(key,dict(calls=0,wall=0,cpu=0));m['calls']+=1;m['wall']+=time.perf_counter()-wall;m['cpu']+=time.process_time()-cpu\n            return patch.object(owner,name,measured)\n        atomic=hi._atomic\n        def persist(path,raw):\n            writes.append(dict(name=path.name,bytes=len(raw)))\n            return atomic(path,raw)\n        run=b.GitStore._run_bytes\n        def command(self,*args,**kwargs):\n            start=time.perf_counter()\n            try:return run(self,*args,**kwargs)\n            finally:git.append(dict(command=args[0],elapsed=time.perf_counter()-start))\n        prof=cProfile.Profile()\n        before_bytes=app.history_index.database.stat().st_size\n        with ExitStack() as stack:\n            for owner,name,key in [(HistoryIndex,'coherent','coherent_full_disk_hash'),(HistoryIndex,'fork','fork_serialize_deserialize'),(HistoryIndex,'publish','publish_full_projection'),(HistoryIndex,'candidate','candidate_total'),(b.GitStore,'prepare_delta','git_prepare_delta'),(b.Core,'_next_generation','generation_path_digest'),(b.Core,'_mutation_context','authorization_dependencies'),(b.TransitionVerifier,'verify','incremental_verification')]:\n                stack.enter_context(wrap(owner,name,key))\n            stack.enter_context(patch.object(hi,'_atomic',persist));stack.enter_context(patch.object(b.GitStore,'_run_bytes',command))\n            wall=time.perf_counter();cpu=time.process_time();prof.enable()\n            app.submit(req)\n            prof.disable();elapsed=time.perf_counter()-wall;cpu=time.process_time()-cpu\n        stats=pstats.Stats(prof)\n        selected=[]\n        for (file,line,name),(cc,nc,tt,ct,callers) in stats.stats.items():\n            if name in ('<method \\'serialize\\' of \\'sqlite3.Connection\\' objects>','<method \\'deserialize\\' of \\'sqlite3.Connection\\' objects>') or 'openssl_sha256' in name or name=='read_bytes':\n                selected.append(dict(file=file,line=line,name=name,calls=nc,self_seconds=tt,cumulative_seconds=ct))\n        rows.append(dict(size=size,hot_revisions=head['revision'],rebuild_seconds=setup,elapsed_seconds=elapsed,cpu_seconds=cpu,database_before=before_bytes,database_after=app.history_index.database.stat().st_size,full_database_serializations=2,serialized_bytes=before_bytes+app.history_index.database.stat().st_size,full_database_read_hash_bytes=2*before_bytes,writes=writes,components=metrics,git_processes=len(git),git=git,python_profile=selected,peak_working_set=b.memory_peak()))\n        OUT.write_text(json.dumps(dict(rows=rows),indent=2)+'\\n')\n        print(json.dumps(rows[-1]),flush=True)\n"
}
